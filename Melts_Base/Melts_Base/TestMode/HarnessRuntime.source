using Melts_Base.BackgroundSync;

internal sealed class HarnessRuntime : IPollingRuntimeOptions
{
    private readonly bool _testMode;

    public HarnessRuntime(string localDatabasePath, bool pollingEnabled = true, bool testMode = true)
    {
        LocalDatabasePath = localDatabasePath;
        PollingEnabled = pollingEnabled;
        _testMode = testMode;
    }
    public bool TestMode => _testMode;
    public bool PollingEnabled { get; }
    public TimeSpan PollingInterval => TimeSpan.FromSeconds(5);
    public string LocalDatabasePath { get; }
}
